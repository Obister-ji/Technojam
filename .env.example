# ─────────────────────────────────────────────────────────────
# TechnoJam web — environment variables
# Copy to .env.local for development. Never commit real values.
# Everything is optional: with nothing set, the site renders from
# the verified seed in src/content/seed.
# ─────────────────────────────────────────────────────────────

# Canonical URL (used for metadata, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.technojam.in

# ── Sanity CMS ───────────────────────────────────────────────
# From sanity.io/manage → your project. Public by design.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-01

# Server-only. Viewer token: enables draft previews from the Studio.
SANITY_API_READ_TOKEN=
# Server-only. Editor token: lets the Collaborate form create `inquiry` docs.
SANITY_API_WRITE_TOKEN=
# Server-only. Shared secret for the Sanity → /api/revalidate webhook.
SANITY_REVALIDATE_SECRET=

# ── GitHub ───────────────────────────────────────────────────
# Optional, server-only. Fine-grained token with public-repo read access.
# Raises the API limit for cached repository metadata (refreshed daily).
GITHUB_TOKEN=

# ── Analytics ────────────────────────────────────────────────
# Optional. Cookieless Plausible analytics; leave empty to disable.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=
